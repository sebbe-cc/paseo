+import { describe, expect, it } from "vitest";
+import { compile, evaluate, initialState } from "../core";
+import { planMessage, planSelectedCount, readPlan } from "../core/decisions";
+import { tableColumnWidths } from "./table-layout";
+
+const badge = (label: string, tone: string) => ({
+  kind: "node",
+  type: "Badge",
+  key: `badge:${label}`,
+  props: { text: label, tone },
+});
+
+describe("Table column widths (short strings and Badge cells)", () => {
+  it("keeps the reported mayor table's columns visible and ordered by content", () => {
+    const columns = ["#", "Saknas", "Hos mayor", "Risk"];
+    const rows = [
+      ["1", "Pluginets runtime: primen ligger i första meddelandet", "gc-runtime i systemprompten", badge("hög", "bad")],
+      ["2", "Skillen gc.mayor laddas inte", "GC_PASEO_SKILLS", badge("låg", "good")],
+    ];
+    const widths = tableColumnWidths(columns, rows);
+    expect(widths).toHaveLength(4);
+    // The one-character "#" / "1" column is narrow but never collapsed away.
+    expect(widths[0]).toBeGreaterThanOrEqual(48);
+    expect(widths[0]).toBeLessThan(widths[1]);
+    // The Badge column gets room for its pill instead of being pushed off screen.
+    expect(widths[3]).toBeGreaterThanOrEqual(48);
+    // The long prose column claims the most room.
+    expect(widths[1]).toBe(Math.max(...widths));
+  });
+
+  it("compiles the reported source with its short strings and Badge nodes intact", () => {
+    const source =
+      'Table(["#", "Saknas", "Hos mayor", "Risk"], [["1", "Pluginets runtime saknas", "gc-runtime", Badge("hög", tone: "bad")]])';
+    const compiled = compile(source);
+    expect(compiled.diagnostics).toEqual([]);
+    const { roots } = evaluate(compiled.program!, initialState(compiled.program!));
+    expect(roots[0].props.columns).toEqual(["#", "Saknas", "Hos mayor", "Risk"]);
+    const rows = roots[0].props.rows as unknown[][];
+    expect(rows[0][0]).toBe("1");
+    expect(rows[0][3]).toMatchObject({ type: "Badge", props: { text: "hög", tone: "bad" } });
+  });
+});
+
+describe("Plan selected count", () => {
+  const { steps } = readPlan([
+    { title: "Konfig och prompt", risk: "low" },
+    { title: "Mail-väckning", risk: "medium" },
+    { title: "Runtimebyte", risk: "high" },
+  ] as never);
+
+  it("counts every ticked step when the persisted checks are still empty", () => {
+    // A Plan first mounted while streaming captures an empty checks array;
+    // the boxes render ticked (`checked[i] !== false`), so the count must too.
+    expect(planSelectedCount(steps, [])).toBe(3);
+    expect(planMessage(steps, [], "")).toBe("Go ahead with the plan.");
+  });
+
+  it("counts explicit unchecks the same way the submit message does", () => {
+    expect(planSelectedCount(steps, [true, false, true])).toBe(2);
+    expect(planSelectedCount(steps, [false, false, false])).toBe(0);
+    expect(steps.map((step) => step.risk)).toEqual(["low", "medium", "high"]);
+  });
+});
