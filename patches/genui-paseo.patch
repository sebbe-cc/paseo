index 0000000..07a9441
--- /dev/null
+++ b/shared/logic/table-layout.ts
@@ -0,0 +1,39 @@
+// Pure column sizing for Table: no React, so it is unit-testable.
+//
+// The old renderer gave every column `flex: 1, minWidth: 110` inside a
+// horizontal ScrollView. In that indefinite-width container the flex basis
+// is meaningless: short-content columns ("#", "1") collapsed to invisibility
+// and wide content pushed the last column (e.g. a Badge column) off screen.
+// Instead each column gets an explicit pixel width from its longest content,
+// so every column is visible; the table only scrolls when the summed minimum
+// widths genuinely exceed the available width.
+import { isNode, text } from "./values";
+
+/** Approximate pixel width of one cell's rendered content. */
+function cellContentWidth(cell: unknown): number {
+  if (isNode(cell)) {
+    const label = text(cell.props.text ?? cell.props.label ?? cell.props.title);
+    // A node (Badge, …) carries chrome around its label: dot, gaps, padding.
+    return (label === "" ? 6 : label.length) * 6.5 + 34;
+  }
+  const value = text(cell);
+  if (value === "") return 24;
+  // Long prose wraps; cap its claim so one verbose column cannot starve the rest.
+  return Math.min(value.length, 48) * 6.5 + 20;
+}
+
+/**
+ * One explicit width per column: at least 48 px (a short header or a
+ * one-character cell stays readable), at most 300 px, sized by the widest
+ * cell or header in the column.
+ */
+export function tableColumnWidths(
+  columns: readonly string[],
+  rows: readonly (readonly unknown[])[],
+): number[] {
+  return columns.map((column, cIdx) => {
+    let widest = column.length * 6.5 + 20;
+    for (const row of rows) widest = Math.max(widest, cellContentWidth(row[cIdx]));
+    return Math.round(Math.min(300, Math.max(48, widest)));
+  });
+}
